{
  "name": "wexample/symfony-helpers",
  "description": "Helpers for symfony development : constants dictionary, helpers, etc.",
  "type": "library",
  "license": "MIT",
  "version": "18.0.0",
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyHelpers\\": "src/"
    }
  },
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "symfony/uid": "^7.4 || ^8.0",
    "symfony/security-core": "^7.4 || ^8.0",
    "symfony/doctrine-bridge": "^7.4 || ^8.0",
    "doctrine/common": "^3.4",
    "doctrine/orm": "^3.3",
    "doctrine/doctrine-bundle": "^2.9",
    "wexample/php-date": ">=2.1.0",
    "wexample/php-file": ">=2.0.0",
    "wexample/php-helpers": ">=7.0.0",
    "symfony/serializer": "^7.4 || ^8.0",
    "symfony/validator": "^7.4 || ^8.0",
    "twig/twig": "^3.6"
  },
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  }
}

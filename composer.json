{
  "name": "wexample/symfony-helpers",
  "description": "Helpers for symfony development : constants dictionary, helpers, etc.",
  "type": "library",
  "license": "MIT",
  "version": "8.0.0",
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyHelpers\\": "src/"
    }
  },
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "twig/string-extra": "^3.6",
    "symfony/twig-bundle": ">=6.2",
    "symfony/uid": ">=6.2",
    "symfony/doctrine-bridge": ">=6.2",
    "laminas/laminas-text": "^2.10",
    "doctrine/common": "^3.4",
    "doctrine/orm": "^3.3",
    "doctrine/doctrine-bundle": "^2.9",
    "wexample/php-date": ">=2.0.0",
    "wexample/php-file": ">=2.0.0",
    "wexample/php-helpers": ">=4.0.0"
  },
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  },
  "suggest": {
    "wexample/symfony-search": "To make the entity traits findable: HasTitleTrait, HasNameTrait, HasBodyTrait, HasDescriptionTrait and HasEmailTrait carry the attribute saying how their column is searched"
  }
}
